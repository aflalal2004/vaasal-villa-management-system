# Vaasal Villa HMS — Lock Bridge configuration (copy to .env)
HMS_API_URL=http://localhost/vaasal_villa_hospitality_management_system28/public/api/v1/lock-bridge
# Token from Admin → Key cards → Lock Bridge → Rotate token (or LOCK_BRIDGE_TOKEN in the app .env on first install)
LOCK_BRIDGE_TOKEN=change-me-bridge-token
# simulator | visionline | ambiance | salto | onity  (anything but "simulator" uses the vendor adapter)
LOCK_VENDOR=simulator
POLL_SECONDS=3
VERIFY_TLS=true
# Vendor-specific (example)
LOCK_SERVER_HOST=192.168.1.20
LOCK_SERVER_PORT=3015
ENCODER_ID=FO-ENC-1
