# Send everything to /public (XAMPP convenience). Production: point the vhost DocumentRoot at /public instead.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
# Never serve project internals
<FilesMatch "^\.env|composer\.(json|lock|phar)$|artisan$">
    Require all denied
</FilesMatch>
