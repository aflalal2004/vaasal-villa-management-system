APP_NAME="Vaasal Villa HMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Colombo
APP_URL=http://localhost/vaasal_villa_hospitality_management_system28/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- New, dedicated database for this project (not shared with any other project) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vaasal_villa_hms28
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_COOKIE=vvhms28_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database
CACHE_PREFIX=vvhms28_

MAIL_MAILER=log
MAIL_FROM_ADDRESS="aflalal2004@gmail.com"
MAIL_FROM_NAME="Vaasal Villa"

# --- Property defaults ---
VV_PROPERTY_CODE=VV
VV_CURRENCY=LKR
VV_HOLD_MINUTES=15
VV_LOGIN_MAX_ATTEMPTS=5
VV_LOGIN_LOCK_MINUTES=15

# --- Payment gateway (hosted checkout; card data never touches this server) ---
# PAYMENT_DRIVER: sandbox | stripe | payhere
PAYMENT_DRIVER=sandbox
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true

# --- Channel manager (OTA) ---
# CHANNEL_DRIVER: null | channex | siteminder
CHANNEL_DRIVER=null
CHANNEX_API_KEY=
CHANNEX_PROPERTY_ID=
CHANNEX_WEBHOOK_SECRET=
CHANNEX_BASE_URL=https://staging.channex.io/api/v1

# --- RFID Lock Bridge ---
# LOCK_DRIVER: simulator (jobs complete inside the app) | bridge (jobs wait for the on-prem Lock Bridge)
LOCK_DRIVER=simulator
LOCK_BRIDGE_TOKEN=change-me-bridge-token

# --- WhatsApp / messaging ---
WHATSAPP_NUMBER=94764413420
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Public-site services ---
GOOGLE_MAPS_EMBED_QUERY="Vaasal Villa, Jaffna, Sri Lanka"
VV_LATITUDE=9.6615
VV_LONGITUDE=80.0255
# Weather uses Open-Meteo (no key). Set to false to disable.
WEATHER_ENABLED=true

SOCIAL_FACEBOOK=https://facebook.com/
SOCIAL_INSTAGRAM=https://instagram.com/
SOCIAL_TIKTOK=https://tiktok.com/
SOCIAL_YOUTUBE=https://youtube.com/

VITE_APP_NAME="${APP_NAME}"

# --- Business contact (defaults; live values are edited in Admin → Website content) ---
VV_CONTACT_PHONE=0764413420
VV_CONTACT_EMAIL=aflalal2004@gmail.com

# --- Display currencies (base currency stays LKR). Leave the key empty to use cached/static rates. ---
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_CACHE_MINUTES=360

# --- Stock media search (server side only; never exposed to the browser) ---
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
MEDIA_API_CACHE_MINUTES=1440

# --- Role quick-fill on the sign-in page (only ever shown when APP_ENV=local) ---
DEMO_LOGIN=true

# --- RFID access devices: allow the in-app simulator (keep true for development) ---
RFID_SIMULATOR=true
